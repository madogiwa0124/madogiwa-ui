{
  "name": "@madogiwa-ui/vue",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/madogiwa-ui-vue.min.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/madogiwa-ui-vue.min.js",
      "default": "./dist/madogiwa-ui-vue.min.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "build:demo": "vite build --mode demo",
    "preview:demo": "pnpm dlx http-server dist/demo",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "vue-tsc --noEmit",
    "test:browser": "vitest --config=vitest.browser.config.ts"
  },
  "description": "A flexible, accessible, next-generation UI framework leveraging cutting-edge CSS features",
  "keywords": [
    "css",
    "css-framework",
    "ui-library",
    "modern-css",
    "vue"
  ],
  "author": "madogiwa0124",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/madogiwa0124/madogiwa-ui.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/madogiwa0124/madogiwa-ui#readme",
  "bugs": {
    "url": "https://github.com/madogiwa0124/madogiwa-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@madogiwa-ui/css": "workspace:^",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "catalog:",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "postcss": "catalog:",
    "postcss-preset-env": "catalog:",
    "typescript": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-vue": "^3.1.0",
    "vue-tsc": "^3.3.14"
  },
  "browserslist": [
    "baseline newly available"
  ]
}
